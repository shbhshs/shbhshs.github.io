---
layout: layouts/base.njk
pagination:
  data: collections.tagList
  size: 1
  alias: tag
eleventyComputed:
  title: "#{{ tag }}"
permalink: /tags/{{ tag | slugify }}/
---
<div class="container narrow">
  <header class="page-header">
    <a class="back-link" href="/tags/">← All tags</a>
    <h1 class="page-title">#{{ tag }}</h1>
  </header>
  {%- set postList = collections.posts | withTag(tag) %}
  {%- if postList.length %}
  <h2 class="label">Posts</h2>
  {% include "partials/post-list.njk" %}
  {%- endif %}
  {%- set videoList = collections.videos | withTag(tag) %}
  {%- if videoList.length %}
  <h2 class="label">Videos</h2>
  {% include "partials/video-grid.njk" %}
  {%- endif %}
</div>
