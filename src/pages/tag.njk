---
layout: layouts/base.njk
pagination:
  data: collections.tagList
  size: 1
  alias: tag
eleventyComputed:
  title: "#{{ tag }}"
permalink: /tags/{{ tag | slugify }}/
---
{% from "macros.njk" import prompt %}
<div class="container">
  <header class="post-header">
    {{ prompt("grep -l '#" + tag + "' *", "~/tags") }}
    <h1 class="page-title">#{{ tag }}</h1>
  </header>
  {%- set postList = collections.posts | withTag(tag) %}
  {%- if postList.length %}{% include "partials/post-list.njk" %}{% endif %}
  {%- set videoList = collections.videos | withTag(tag) %}
  {%- if videoList.length %}
  <section class="block">
    <h2 class="year-title">videos</h2>
    {% include "partials/video-grid.njk" %}
  </section>
  {%- endif %}
  <p class="more"><a href="/tags/">cd ../ →</a></p>
</div>
