---
layout: layouts/base.njk
pagination:
  data: collections.tagList
  size: 1
  alias: tag
eleventyComputed:
  title: "#{{ tag }}"
permalink: /tags/{{ tag | slugify }}/
---
<div class="container">
  <header class="page-header">
    <h1 class="page-title">#{{ tag }}</h1>
    <p class="lead"><a href="/tags/">All tags</a></p>
  </header>
  {%- set postList = collections.posts | withTag(tag) %}
  {%- if postList.length %}
  {% include "partials/post-list.njk" %}
  {%- endif %}
  {%- set videoList = collections.videos | withTag(tag) %}
  {%- if videoList.length %}
  <section class="section">
    <h2 class="section-title">Videos</h2>
    {% include "partials/video-grid.njk" %}
  </section>
  {%- endif %}
</div>
