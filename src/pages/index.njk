---
layout: layouts/base.njk
permalink: /
---
{% from "macros.njk" import prompt %}
<div class="container home">
  <section class="block">
    {{ prompt("whoami") }}
    <div class="whoami">
      <img class="avatar" src="{{ site.author.avatar }}" alt="Photo of {{ site.author.name }}" width="96" height="96">
      <div>
        <h1>{{ site.author.name }}</h1>
        <p class="role">{{ site.author.role }}{% if site.author.location %} <span class="dim">@</span> {{ site.author.location }}{% endif %}</p>
      </div>
    </div>
    <p class="tagline">{{ site.author.tagline }}</p>
    <p class="bio">{{ site.author.bio }}</p>
  </section>

  {%- if site.now.length %}
  <section class="block">
    {{ prompt("cat now.md") }}
    <ul class="dash-list">
      {%- for item in site.now %}<li>{{ item }}</li>{% endfor %}
    </ul>
  </section>
  {%- endif %}

  <section class="block">
    {{ prompt("ls -t writing/ | head -5") }}
    {%- set postList = collections.posts | head(5) %}
    {%- if postList.length %}
    {% include "partials/post-list.njk" %}
    <p class="more"><a href="/blog/">cd blog/ →</a></p>
    {%- else %}<p class="dim">total 0</p>{% endif %}
  </section>

  {%- if collections.videos.length %}
  <section class="block">
    {{ prompt("ls videos/") }}
    {%- set videoList = collections.videos | head(2) %}
    {% include "partials/video-grid.njk" %}
    <p class="more"><a href="/videos/">cd videos/ →</a></p>
  </section>
  {%- endif %}

  <section class="block">
    {{ prompt("contact --list") }}
    {% include "partials/contact.njk" %}
  </section>

  <p class="prompt prompt-idle"><span class="prompt-path">~</span> <span class="prompt-sign">$</span> <span class="cursor" aria-hidden="true"></span></p>
</div>
