---
layout: layouts/base.njk
permalink: /
---
<div class="container">
  {% include "partials/profile.njk" %}

  {%- if site.now.length or site.stack.length %}
  <section class="cards-2">
    {%- if site.now.length %}
    <div class="card">
      <h2 class="label">Now</h2>
      <ul class="now-list">
        {%- for item in site.now %}<li>{{ item }}</li>{% endfor %}
      </ul>
    </div>
    {%- endif %}
    {%- if site.stack.length %}
    <div class="card">
      <h2 class="label">Toolbox</h2>
      <ul class="chips">
        {%- for item in site.stack %}<li>{{ item }}</li>{% endfor %}
      </ul>
    </div>
    {%- endif %}
  </section>
  {%- endif %}

  <section class="section">
    <div class="section-head">
      <h2>Latest writing</h2>
      <a href="/blog/">All posts {% icon "arrow" %}</a>
    </div>
    {%- set postList = collections.posts | head(4) %}
    {%- if postList.length %}{% include "partials/post-list.njk" %}{% else %}<p class="muted">Nothing here yet — check back soon.</p>{% endif %}
  </section>

  {%- if collections.videos.length %}
  <section class="section">
    <div class="section-head">
      <h2>Latest videos</h2>
      <a href="/videos/">All videos {% icon "arrow" %}</a>
    </div>
    {%- set videoList = collections.videos | head(3) %}
    {% include "partials/video-grid.njk" %}
  </section>
  {%- endif %}
</div>
