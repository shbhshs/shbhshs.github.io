---
layout: layouts/base.njk
permalink: /
---
<div class="container">
  {% include "partials/profile.njk" %}

  {%- if site.now.length %}
  <section class="section">
    <h2 class="section-title">Now</h2>
    <ul class="plain-list">
      {%- for item in site.now %}<li>{{ item }}</li>{% endfor %}
    </ul>
  </section>
  {%- endif %}

  <section class="section">
    <h2 class="section-title">Writing</h2>
    {%- set postList = collections.posts | head(5) %}
    {%- if postList.length %}
    {% include "partials/post-list.njk" %}
    <p class="more"><a href="/blog/">All posts →</a></p>
    {%- else %}<p class="muted">Nothing here yet.</p>{% endif %}
  </section>

  {%- if collections.videos.length %}
  <section class="section">
    <h2 class="section-title">Videos</h2>
    {%- set videoList = collections.videos | head(2) %}
    {% include "partials/video-grid.njk" %}
    <p class="more"><a href="/videos/">All videos →</a></p>
  </section>
  {%- endif %}
</div>
