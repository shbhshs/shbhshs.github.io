---
layout: layouts/base.njk
title: Blog
pagination:
  data: collections.posts
  size: 50
  alias: postList
permalink: "/blog/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}"
---
{% from "macros.njk" import prompt %}
<div class="container">
  <header class="post-header">
    {{ prompt("ls -t", "~/blog") }}
    <h1 class="page-title">Writing</h1>
    <p class="lead">Notes and write-ups, mostly about software. Subscribe via <a href="/feed.xml">rss</a>.</p>
  </header>

  {%- for post in postList %}
    {%- set y = post.date | year %}
    {%- set prevY = (postList[loop.index0 - 1].date | year) if not loop.first else "" %}
    {%- set nextY = (postList[loop.index0 + 1].date | year) if not loop.last else "" %}
    {%- if y != prevY %}
  <section class="year">
    <h2 class="year-title">{{ y }}</h2>
    <ul class="post-list">
    {%- endif %}
      <li>
        <a href="{{ post.url }}">
          <time datetime="{{ post.date | isoDate }}">{{ post.date | isoDate | replace(y + "-", "") }}</time>
          <span class="post-title">{{ post.data.title }}{% if post.data.draft %} <span class="badge">draft</span>{% endif %}</span>
          <span class="post-tags">{% for t in post.data.tags | publicTags | head(2) %}#{{ t }} {% endfor %}</span>
        </a>
      </li>
    {%- if y != nextY %}
    </ul>
  </section>
    {%- endif %}
  {%- endfor %}

  {%- if pagination.pages.length > 1 %}
  <nav class="pager" aria-label="Pagination">
    {%- if pagination.href.previous %}<a href="{{ pagination.href.previous }}">← newer</a>{% else %}<span></span>{% endif %}
    {%- if pagination.href.next %}<a class="next" href="{{ pagination.href.next }}">older →</a>{% endif %}
  </nav>
  {%- endif %}
</div>
