---
layout: layouts/base.njk
title: Blog
pagination:
  data: collections.posts
  size: 30
  alias: postList
permalink: "/blog/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}"
---
<div class="container">
  <header class="page-header">
    <h1 class="page-title">Blog</h1>
    <p class="lead">Notes and write-ups, mostly about software. Subscribe via <a href="/feed.xml">RSS</a>.</p>
  </header>
  {% include "partials/post-list.njk" %}

  {%- if pagination.pages.length > 1 %}
  <nav class="pager" aria-label="Pagination">
    {%- if pagination.href.previous %}<a href="{{ pagination.href.previous }}">← Newer</a>{% else %}<span></span>{% endif %}
    {%- if pagination.href.next %}<a class="next" href="{{ pagination.href.next }}">Older →</a>{% endif %}
  </nav>
  {%- endif %}
</div>
