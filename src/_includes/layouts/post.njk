---
layout: layouts/base.njk
---
{% from "macros.njk" import prompt %}
<article class="container post">
  <header class="post-header">
    {{ prompt("cat " + page.fileSlug + ".md", "~/blog") }}
    <h1 class="page-title">{{ title }}</h1>
    <p class="meta">
      <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
      <span class="dim">·</span> {{ content | readingTime }}
      {%- if draft %} <span class="dim">·</span> <span class="badge">draft</span>{% endif %}
    </p>
    {% include "partials/tags.njk" %}
  </header>

  {%- if youtube %}{% youtube youtube, title %}{% endif %}

  <div class="prose">
    {{ content | safe }}
  </div>

  {%- set prev = collections.posts | getNextCollectionItem(page) %}
  {%- set next = collections.posts | getPreviousCollectionItem(page) %}
  <footer class="post-footer">
    {%- if prev or next %}
    <nav class="pager" aria-label="More posts">
      {%- if prev %}<a href="{{ prev.url }}"><span class="dim">← prev</span>{{ prev.data.title }}</a>{% else %}<span></span>{% endif %}
      {%- if next %}<a class="next" href="{{ next.url }}"><span class="dim">next →</span>{{ next.data.title }}</a>{% endif %}
    </nav>
    {%- endif %}
    <p class="more"><a href="/blog/">cd ../ →</a></p>
  </footer>
</article>
