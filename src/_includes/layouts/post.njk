---
layout: layouts/base.njk
---
<article class="container narrow post">
  <header class="post-header">
    <a class="back-link" href="/blog/">← All posts</a>
    <h1 class="page-title">{{ title }}</h1>
    {%- if summary %}<p class="lead">{{ summary }}</p>{% endif %}
    <div class="byline">
      <img src="{{ site.author.avatar }}" alt="" width="40" height="40">
      <div>
        <strong>{{ site.author.name }}</strong>
        <span class="muted"><time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time> · {{ content | readingTime }}{% if draft %} · <span class="badge">draft</span>{% endif %}</span>
      </div>
    </div>
    {% include "partials/tags.njk" %}
  </header>

  {%- if youtube %}{% youtube youtube, title %}{% endif %}

  <div class="prose">
    {{ content | safe }}
  </div>

  {%- set prev = collections.posts | getNextCollectionItem(page) %}
  {%- set next = collections.posts | getPreviousCollectionItem(page) %}
  {%- if prev or next %}
  <nav class="pager" aria-label="More posts">
    {%- if prev %}<a href="{{ prev.url }}"><small>Older</small>{{ prev.data.title }}</a>{% else %}<span></span>{% endif %}
    {%- if next %}<a class="next" href="{{ next.url }}"><small>Newer</small>{{ next.data.title }}</a>{% endif %}
  </nav>
  {%- endif %}
</article>
