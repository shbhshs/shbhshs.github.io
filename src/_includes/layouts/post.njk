---
layout: layouts/base.njk
---
<article class="container post">
  <header class="page-header">
    <h1 class="page-title">{{ title }}</h1>
    <p class="meta">
      <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time> · {{ content | readingTime }}
      {%- if draft %} · <span class="badge">draft</span>{% endif %}
    </p>
  </header>

  {%- if youtube %}{% youtube youtube, title %}{% endif %}

  <div class="prose">
    {{ content | safe }}
  </div>

  <footer class="post-footer">
    {% include "partials/tags.njk" %}
    {%- set prev = collections.posts | getNextCollectionItem(page) %}
    {%- set next = collections.posts | getPreviousCollectionItem(page) %}
    {%- if prev or next %}
    <nav class="pager" aria-label="More posts">
      {%- if prev %}<a href="{{ prev.url }}">← {{ prev.data.title }}</a>{% else %}<span></span>{% endif %}
      {%- if next %}<a class="next" href="{{ next.url }}">{{ next.data.title }} →</a>{% endif %}
    </nav>
    {%- endif %}
  </footer>
</article>
