---
layout: layouts/base.njk
---
<article class="container">
  <header class="page-header about-header">
    <img class="avatar" src="{{ site.author.avatar }}" alt="Photo of {{ site.author.name }}" width="88" height="88">
    <h1 class="page-title">{{ title }}</h1>
  </header>
  <div class="prose">
    {{ content | safe }}
  </div>
  {%- if site.stack.length %}
  <section class="section">
    <h2 class="section-title">Toolbox</h2>
    <p class="muted">{{ site.stack | join(" · ") }}</p>
  </section>
  {%- endif %}
  <section class="section">
    <h2 class="section-title">Elsewhere</h2>
    {% include "partials/reach-links.njk" %}
  </section>
</article>
