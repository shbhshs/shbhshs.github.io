---
layout: layouts/base.njk
---
<article class="post">
  <header class="post-header">
    <h1>{{ title }}</h1>
    <p class="meta"><time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time></p>
    {% include "partials/tags.njk" %}
  </header>

  {%- if youtube %}{% youtube youtube, title %}
  {%- elif vimeo %}{% vimeo vimeo, title %}
  {%- elif src %}{% video src, thumbnail %}
  {%- endif %}

  <div class="prose">
    {{ content | safe }}
  </div>
</article>
