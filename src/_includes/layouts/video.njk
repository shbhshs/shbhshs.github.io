---
layout: layouts/base.njk
---
{% from "macros.njk" import prompt %}
<article class="container post">
  <header class="post-header">
    {{ prompt("play " + page.fileSlug, "~/videos") }}
    <h1 class="page-title">{{ title }}</h1>
    <p class="meta"><time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>{% if draft %} <span class="dim">·</span> <span class="badge">draft</span>{% endif %}</p>
    {% include "partials/tags.njk" %}
  </header>

  {%- if youtube %}{% youtube youtube, title %}
  {%- elif vimeo %}{% vimeo vimeo, title %}
  {%- elif src %}{% video src, thumbnail %}
  {%- endif %}

  <div class="prose">
    {{ content | safe }}
  </div>

  <footer class="post-footer"><p class="more"><a href="/videos/">cd ../ →</a></p></footer>
</article>
