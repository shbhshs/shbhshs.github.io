---
layout: layouts/base.njk
---
<article class="container post">
  <header class="page-header">
    <h1 class="page-title">{{ title }}</h1>
    <p class="meta"><time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>{% if draft %} · <span class="badge">draft</span>{% endif %}</p>
  </header>

  {%- if youtube %}{% youtube youtube, title %}
  {%- elif vimeo %}{% vimeo vimeo, title %}
  {%- elif src %}{% video src, thumbnail %}
  {%- endif %}

  <div class="prose">
    {{ content | safe }}
  </div>

  <footer class="post-footer">{% include "partials/tags.njk" %}</footer>
</article>
