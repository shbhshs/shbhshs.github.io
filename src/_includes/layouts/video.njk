---
layout: layouts/base.njk
---
<article class="container narrow post">
  <header class="post-header">
    <a class="back-link" href="/videos/">← All videos</a>
    <h1 class="page-title">{{ title }}</h1>
    <p class="muted"><time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>{% if draft %} · <span class="badge">draft</span>{% endif %}</p>
    {% include "partials/tags.njk" %}
  </header>

  {%- if youtube %}{% youtube youtube, title %}
  {%- elif vimeo %}{% vimeo vimeo, title %}
  {%- elif src %}{% video src, thumbnail %}
  {%- endif %}

  <div class="prose">
    {{ content | safe }}
  </div>
</article>
