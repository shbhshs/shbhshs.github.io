{# Expects `postList` to be set by the caller. #}
<ul class="post-list">
  {%- for post in postList %}
  <li>
    <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
    <div>
      <a href="{{ post.url }}">{{ post.data.title }}</a>{% if post.data.draft %} <span class="badge">draft</span>{% endif %}
      {%- if post.data.summary %}<p>{{ post.data.summary }}</p>{% endif %}
    </div>
  </li>
  {%- endfor %}
</ul>
