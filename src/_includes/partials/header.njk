<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <img src="{{ site.author.avatar }}" alt="" width="32" height="32">
      <span>{{ site.title }}</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {%- for item in site.nav %}
        <li><a href="{{ item.url }}"{% if page.url.startsWith(item.url) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
    <button class="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
      <span class="icon-sun">{% icon "sun" %}</span><span class="icon-moon">{% icon "moon" %}</span>
    </button>
  </div>
</header>
